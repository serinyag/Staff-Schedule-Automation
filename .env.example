NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional local development origin when running Vercel dev (includes Python solver).
# SCHEDULE_APP_ORIGIN=http://localhost:3000

# Google Calendar is optional. Leave these unset to keep connection setup disabled.
# OAuth web application credentials; never use NEXT_PUBLIC_ for these.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_ENCRYPTION_KEY= # 64 hex characters, generated with openssl rand -hex 32
