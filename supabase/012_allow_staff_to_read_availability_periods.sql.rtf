\f0\fs24 \cf0 -- 012_allow_staff_to_read_availability_periods.sql\
\
drop policy if exists schedule_periods_select\
on public.schedule_periods;\
\
\
create policy schedule_periods_select\
on public.schedule_periods\
for select\
to authenticated\
using (\
  public.is_manager_or_admin()\
\
  or (\
\
    exists (\
      select 1\
      from public.profiles p\
      where p.id = (select auth.uid())\
        and p.is_active = true\
    )\
\
    and status in (\
      'collecting_availability',\
      'published',\
      'locked'\
    )\
\
  )\
);}